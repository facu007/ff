# ============================================================================
# TRANSPORTE EXPRESO 38 S.R.L. — CONFIGURACIÓN DE ENTORNO (.env)
# Copie este archivo como ".env" en la raíz del proyecto y complete sus claves
# ============================================================================

PORT=8080

# ----------------------------------------------------------------------------
# 1. BASE DE DATOS EN LA NUBE — SUPABASE (PostgreSQL + REST API)
# Ejecute primero el script SQL en: supabase/schema.sql
# ----------------------------------------------------------------------------
SUPABASE_URL=https://tu-proyecto-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta
SUPABASE_ANON_KEY=tu-anon-public-key

# ----------------------------------------------------------------------------
# 2. NOTIFICACIONES POR CORREO ELECTRÓNICO (SMTP / Nodemailer)
# Ejemplos: Gmail (smtp.gmail.com:465 con App Password), Brevo, Resend, cPanel
# ----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=comercial@expreso38.com
SMTP_PASS=tu-password-o-app-password-smtp
SMTP_FROM="Transporte Expreso 38 SRL <comercial@expreso38.com>"

# Correo corporativo oficial que recibe las alertas de nuevas cotizaciones B2B
NOTIFY_EMAIL=comercial@expreso38.com

# WhatsApp Administración para enlaces rápidos (Manuel: 5492914276253 / Brenda: 5492804873742)
WHATSAPP_NUMBER=5492914276253

# Token opcional para proteger endpoints administrativos (GET/PATCH /api/cotizaciones)
ADMIN_TOKEN=

